{
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.executorMap": {
        "c": "cd \"$dir\"; gcc \"$fileName\" -o \"$fileNameWithoutExt.exe\"; if ($?) { .\\\"$fileNameWithoutExt.exe\" }",
        "cpp": "cd \"$dir\"; g++ -std=c++20 \"$fileName\" -o \"$fileNameWithoutExt.exe\"; if ($?) { .\\\"$fileNameWithoutExt.exe\" }"
    }
}
